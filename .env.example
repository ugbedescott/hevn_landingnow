# SendGrid API key
SENDGRID_API_KEY=your_sendgrid_api_key_here

# From address used to send waitlist emails
SENDGRID_FROM=no-reply@yourdomain.com

# Optional: override recipient for waitlist notifications (team inbox)
WAITLIST_TO=team@yourdomain.com

# Supabase (optional - required to persist waitlist in DB)
SUPABASE_URL=https://xyzcompany.supabase.co
SUPABASE_SERVICE_ROLE_KEY=service_role_key_here

# Optional local dev
PORT=3000
